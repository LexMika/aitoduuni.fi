  "rules": {
    "sources": "15–18",
    "doors_per_source": "2–4",
    "cadence": "viikko + manuaali nyt",
    "browser_budget": "Hilma deep-link max 1–2 korttia / ajo",
    "exclude": [
      "uudet CloudNC-kaupungit",
      "MML-avain",
      "Dynasty-massa",
      "B2B-join"
    ],
    "door_roles": {
      "primary": "Pääovi — miten normally haetaan",
      "content": "Sisältö — rivit > 0 / ei pelkkä HTTP 200",
      "angle": "Toinen kulma — vuosi/q/offset/vanha vs tuore",
      "alt": "Vaihtoehtoinen ovi — vain jos sivulla väitetään (TED / Ilmoitusote / …)"
    },
    "pass_fail": "HIT/OK = odote täyttyy · MISS/HARD = aukeaa mutta tyhjä/katkee · FAIL/NO = estetty kuten sivulla · SKIP = ovessa ei ajettavaa"
  },
  "runner": {
    "status": "katalogi valmis · smoke myöhemmin",
    "venv": "vallanvahtikoira/.venv/bin/python",
    "nurkka": "bash tools/nurkka_data.sh py -- …",
    "out_json": "data/work/toimiiko_probe_report.json",
    "out_md": "JULKAISU_ALUSTA/sivut/toimiiko-lahde/_luonnos/probe_report.md"
  },
